{
  "name": "@dcdavidev/notebook",
  "version": "0.1.0",
  "private": true,
  "description": "Digital notebook for free programming courses, downloadable study notes, and personal hobbies.",
  "keywords": [
    "notebook",
    "programming",
    "courses",
    "study-notes",
    "nextjs"
  ],
  "homepage": "https://notebook.dcdavidev.me",
  "bugs": {
    "url": "https://github.com/dcdavidev/notebook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/notebook.git"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Davide Di Criscito",
    "url": "https://dcdavidev.me"
  },
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "pnpm run lint:check && pnpm run fmt:check && pnpm run spellcheck && pnpm run typecheck",
    "commit": "czg",
    "commit:lint": "commitlint --from=HEAD~1",
    "dev": "next dev",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "postinstall": "node scripts/copy-lottie-wasm.mjs",
    "lint": "eslint --no-warn-ignored --fix .",
    "lint:check": "eslint --no-warn-ignored .",
    "prepare": "lefthook install",
    "spellcheck": "cspell --no-progress --no-summary .",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/pt-mono": "^5.3.0",
    "@fontsource/satisfy": "^5.3.0",
    "@lottiefiles/dotlottie-react": "^0.22.3",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@shikijs/rehype": "^4.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tabler/icons-react": "^3.52.0",
    "@vercel/analytics": "^2.0.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "fflate": "^0.8.3",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@cspell/cspell-types": "^10.5.2",
    "@cspell/dict-it-it": "^3.1.7",
    "@next/eslint-plugin-next": "16.4.6",
    "@prettier/plugin-xml": "^3.4.2",
    "@spellbookx/recipes": "^1.3.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitlint-config-spellbookx": "^1.3.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cspell": "^10.5.2",
    "cspell-config-spellbookx": "^1.3.0",
    "cz-config-spellbookx": "^1.3.0",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-spellbookx": "^1.3.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-config-spellbookx": "^1.3.0",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-properties": "^0.4.0",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-toml": "^4.1.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
}
